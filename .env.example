NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Wire Payment. WIRE_API_KEY нь зөвхөн server талд ашиглагдана.
WIRE_API_KEY=
WIRE_API_BASE_URL=https://api.wirepayment.mn

# Сонголттой. Олон operator бол таслалаар тусгаарлана.
WIRE_ALLOWED_OPERATORS=
WIRE_OPERATOR=

# Webhook. Endpoint үүсгэх үед НЭГ УДАА харуулдаг signing secret (whsec_...).
WIRE_WEBHOOK_SECRET=

# Webhook нь хэрэглэгчийн session-гүй ажилладаг тул RLS-ийг тойрох түлхүүр хэрэгтэй.
# Supabase → Project Settings → API → service_role. Client-д БҮҮ байршуул.
SUPABASE_SERVICE_ROLE_KEY=
