NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Wire Payment. WIRE_API_KEY нь зөвхөн server талд ашиглагдана.
WIRE_API_KEY=
WIRE_API_BASE_URL=https://api.wire.mn

# Сонголттой. Олон operator бол таслалаар тусгаарлана.
WIRE_ALLOWED_OPERATORS=
WIRE_OPERATOR=

# Webhook. Endpoint үүсгэх үед НЭГ УДАА харуулдаг signing secret (whsec_...).
WIRE_WEBHOOK_SECRET=

# Webhook нь хэрэглэгчийн session-гүй ажилладаг тул RLS-ийг тойрох түлхүүр хэрэгтэй.
# Supabase → Project Settings → API → service_role. Client-д БҮҮ байршуул.
SUPABASE_SERVICE_ROLE_KEY=

# Захиалгын мэдэгдэл. Resend-ийн API key (re_...).
RESEND_API_KEY=
# Илгээгчийн хаяг. Домэйн Resend дээр баталгаажсан байх ёстой.
EMAIL_FROM=LS Tech Store <noreply@lstechstore.com>
# Шинэ захиалгын мэдэгдэл хүлээн авах хаяг.
ADMIN_NOTIFY_EMAIL=
# Supabase Database Webhook-той тохирох санамсаргүй нууц үг.
ORDER_NOTIFY_SECRET=
